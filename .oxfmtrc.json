{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "printWidth": 80,
  "sortPackageJson": false,
  "ignorePatterns": [
    "package-lock.json",
    "pnpm-lock.yaml",
    "yarn.lock",
    "bun.lock",
    "bun.lockb",
    "app/*.json",
    "scripts/*.json",
    "scripts/notes/**",
    "public/**",
    "private-assets/**",
    "dist/**",
    "*.md",
    "docs/**"
  ]
}
