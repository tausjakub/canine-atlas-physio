{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-private-assets.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-edited.mjs\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(npm run typecheck)",
      "Bash(npm run validate)",
      "Bash(npm run build:demo)",
      "Bash(npx tsc --noEmit)",
      "Bash(npx oxlint:*)",
      "Bash(npx oxfmt:*)",
      "Bash(node scripts/validate-all.mjs:*)",
      "Bash(node scripts/mobile-check.mjs:*)",
      "Bash(node scripts/check-pages.mjs)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(./.env*)",
      "Read(./.dev.vars*)",
      "Edit(./private-assets/**)",
      "Write(./private-assets/**)"
    ]
  }
}
